# /etc/chores/chores.env: read by the systemd service.
CHORES_INSTANCE=/var/lib/chores          # database + secret key live here
CHORES_TIMEZONE=America/New_York
CHORES_WEEK_START=0                      # 0 = Monday, 6 = Sunday
CHORES_HOST=127.0.0.1                    # only the reverse proxy talks to the app
CHORES_PORT=8087
CHORES_BEHIND_PROXY=1                    # trust X-Forwarded-For/Proto from Caddy/nginx
CHORES_SECURE_COOKIES=1                  # cookies only over HTTPS; set 0 for plain-http LAN testing
