.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# Visual Studio (full IDE / Python Tools)
.vs/
*.pyproj.user
*.suo
*.user

# JetBrains
.idea/

