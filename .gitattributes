# Normalise line endings in the repo; keep files the Pi executes as LF even if edited on Windows.
* text=auto
*.sh        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
Caddyfile   text eol=lf
*.conf      text eol=lf
*.example   text eol=lf
manage.py   text eol=lf
*.svg       text
*.png       binary
*.xlsx      binary
*.sqlite3   binary
