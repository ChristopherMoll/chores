# /etc/chores/chores.env: read by the systemd service.
# Keep comments on their own lines. systemd treats text after a value as part of the value.

# Database, secret key and push signing keys live here.
CHORES_INSTANCE=/var/lib/chores
CHORES_TIMEZONE=America/New_York
# 0 = Monday, 6 = Sunday
CHORES_WEEK_START=0
# Only the reverse proxy talks to the app.
CHORES_HOST=127.0.0.1
CHORES_PORT=8087
# Trust X-Forwarded-For/Proto from Caddy/nginx.
CHORES_BEHIND_PROXY=1
# Cookies only over HTTPS. Set to 0 for plain-http LAN testing.
CHORES_SECURE_COOKIES=1
# Identifies this server to Apple's push service. Must be an https:// URL or a mailto: address.
CHORES_VAPID_SUBJECT=https://chores.moll.casa
